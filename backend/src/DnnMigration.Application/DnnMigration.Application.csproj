<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DnnMigration.Application
    ============================================================================
    SDK-style C# class library for the APPLICATION layer of the DNN 4.x -> .NET 8
    Clean/Onion Architecture backend. It contains the business-logic services,
    Create/Update/Read DTOs, AutoMapper profiles, FluentValidation validators,
    service and identity-port interfaces, and the response envelope.

    Dependency direction (Clean Architecture, inward only):
        Api -> Application -> Domain ;  Infrastructure -> Domain
    This project is referenced by DnnMigration.Infrastructure and DnnMigration.Api,
    and it references ONLY DnnMigration.Domain. It must NEVER reference
    Infrastructure or Api (that would invert the architecture and create a cycle).

    Shared build configuration is centralized in backend/Directory.Build.props,
    which MSBuild imports automatically by walking up the directory tree. That
    props file is the single source of truth for TargetFramework (net8.0),
    LangVersion (12.0), Nullable, ImplicitUsings, TreatWarningsAsErrors,
    WarningsNotAsErrors (CS8618), Deterministic and GenerateDocumentationFile, so
    none of those settings are repeated here. The output type defaults to a class
    library, and RootNamespace/AssemblyName default from the file name
    'DnnMigration.Application' (matching DnnMigration.Application.Services /
    .DTOs / .Mapping / .Validators / .Interfaces / .Common), so no PropertyGroup
    or OutputType override is required.

    Package references are intentionally limited to the two libraries the layer
    consumes directly:
      * AutoMapper 15.1.1 (referenced directly; from v13+ the Microsoft.Extensions.DI
        integration is part of the core package, so the former
        AutoMapper.Extensions.Microsoft.DependencyInjection extension is no longer
        used). Used by the Mapping/ entity<->DTO profiles (and wired in the Api
        composition root via AddAutoMapper(...)). The 15.x line is the patched
        baseline for advisory GHSA-rvv3-g6hj-g44x (see the ItemGroup note below
        and MIGRATION_NOTES.md §7.1).
      * FluentValidation 11.5.1 + FluentValidation.DependencyInjectionExtensions 11.5.1,
        used by the Validators/ rules. The Application services invoke validators
        explicitly (manual ValidateAndThrowAsync), and AddValidatorsFromAssembly(...)
        (from the DependencyInjectionExtensions package) registers them in the Api
        composition root. The deprecated/unmaintained FluentValidation.AspNetCore bundle
        (which added MVC auto-validation this layer does not use) is intentionally NOT
        referenced (CP4 dependency-support finding; see MIGRATION_NOTES.md §7.1).
    DI registration itself (AddAutoMapper, AddValidatorsFromAssembly, AddScoped)
    lives in the Api Program.cs composition root, not here. EF Core, JWT and
    BCrypt packages belong to the Infrastructure project and are deliberately
    absent from this layer.

    Structure reference only (NOT a 1:1 port): the legacy VB.NET project
    Library/DotNetNuke.Library.vbproj. No legacy <Import>, Option Strict/Explicit,
    VB runtime references, or System.* assembly <Reference> items are carried over.
    ============================================================================
  -->

  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Domain\DnnMigration.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- SECURITY (CP2 dependency advisory): AutoMapper 12.0.1 (brought transitively by the legacy
         AutoMapper.Extensions.Microsoft.DependencyInjection 12.0.1 pin) carries HIGH advisory
         GHSA-rvv3-g6hj-g44x (uncontrolled recursion on self-referential graphs → stack-exhaustion DoS).
         Remediated by upgrading to the patched 15.x line. As of AutoMapper 13+, the Microsoft.Extensions.DI
         integration was merged INTO the core AutoMapper package, so the separate extension package is removed
         and AutoMapper is referenced directly. This is a security-mandated deviation from the AAP §0.5.1 pin,
         authorized by AAP §0.7.2 ("no known vulnerable supported packages"); see MIGRATION_NOTES.md §7.1. -->
    <PackageReference Include="AutoMapper" Version="15.1.1" />
    <!-- DEPENDENCY SUPPORT (CP4 finding): FluentValidation.AspNetCore is DEPRECATED/unmaintained. Replaced with
         the supported ASP.NET Core 8 pattern — the core FluentValidation library plus
         FluentValidation.DependencyInjectionExtensions, which provides AddValidatorsFromAssembly(...). Validation
         is invoked explicitly in the Application services (ValidateAndThrowAsync), so the MVC auto-validation that
         FluentValidation.AspNetCore bundled is not required. Both pins track the 11.5.1 line. See
         MIGRATION_NOTES.md §7.1. -->
    <PackageReference Include="FluentValidation" Version="11.5.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.5.1" />
  </ItemGroup>

</Project>
