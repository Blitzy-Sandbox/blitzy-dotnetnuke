{
  "ConnectionStrings": {
    "Default": "Server=localhost,1433;Database=DotNetNuke;User Id=__DB_USER__;Password=__DB_PASSWORD__;TrustServerCertificate=True;MultipleActiveResultSets=True"
  },
  "Jwt": {
    "Issuer": "DnnMigration",
    "Audience": "DnnMigration",
    "Key": "",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "LuckyPennySoftware.AutoMapper.License": "Fatal"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
