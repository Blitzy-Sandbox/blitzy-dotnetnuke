<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- MIGRATION: Gate 1 builds with warnings treated as errors (the Release build runs with the warnaserror
         switch) but EXCLUDES CS8618 (non-nullable field uninitialized). Use WarningsNotAsErrors (NOT NoWarn) so
         CS8618 stays a visible warning yet does not fail the build. -->
    <WarningsNotAsErrors>CS8618</WarningsNotAsErrors>
    <RootNamespace>DnnMigration.Infrastructure</RootNamespace>
    <AssemblyName>DnnMigration.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- AAP §0.5.1 PINNED production packages -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!-- MIGRATION (build-correctness): EF Core 8's transitive closure provides
         Microsoft.Extensions.{DependencyInjection,Options,Logging,Caching.Memory,Primitives}(.Abstractions)
         but NOT Microsoft.Extensions.Configuration.Abstractions. DependencyInjection.AddInfrastructure(IServiceCollection, IConfiguration)
         uses IConfiguration + GetConnectionString, and JwtService binds the "Jwt" config section, so these are added explicitly. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Clean Architecture: Infrastructure references Domain + Application ONLY (NEVER Api). -->
    <ProjectReference Include="..\DnnMigration.Domain\DnnMigration.Domain.csproj" />
    <ProjectReference Include="..\DnnMigration.Application\DnnMigration.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIGRATION (CP4 review - dependency-safety, advisory consistency): scoped, advisory-specific NuGet audit
         suppression for GHSA-rvv3-g6hj-g44x (CVE-2026-32933) - AutoMapper uncontrolled-recursion DoS (CWE-674).
         This project transitively carries AutoMapper 12.0.1 through its DnnMigration.Application reference above,
         so under NuGetAuditMode=all the advisory surfaces here as well. The suppression mirrors the identical
         scoped suppression in DnnMigration.Api.csproj and DnnMigration.Application.csproj so the ENTIRE build
         graph (production + tests) treats the advisory consistently and stays clean under any audit mode.
         Rationale: AAP section 0.5.1 pins AutoMapper to 12.0.1 (no patched 12.x line; 15.1.1 / 16.1.1 are
         paid-license and out of scope / offline); the DoS requires cyclic / self-referential maps, and every
         Application profile maps FLAT POCO/DTO shapes (proven by AutoMapperConfigurationTests). Recorded in
         MIGRATION_NOTES.md section 17. Revisit when the AAP is allowed to advance AutoMapper to a patched line. -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-rvv3-g6hj-g44x" />
  </ItemGroup>

</Project>
