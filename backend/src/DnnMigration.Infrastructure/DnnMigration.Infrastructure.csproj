<Project Sdk="Microsoft.NET.Sdk">

  <!--
    DnnMigration.Infrastructure — EF Core persistence (DnnDbContext + IEntityTypeConfiguration),
    repository implementations, and identity primitives (PasswordHasher/BCrypt).
    Depends on Domain and Application.
    Common build settings inherited from backend/Directory.Build.props.

    NOTE (setup): JWT Bearer authentication middleware registration lives in the Api layer
    (Program.cs). If a JwtService in Infrastructure later needs token primitives directly,
    file-implementation agents may add System.IdentityModel.Tokens.Jwt here.
  -->

  <PropertyGroup>
    <RootNamespace>DnnMigration.Infrastructure</RootNamespace>
    <AssemblyName>DnnMigration.Infrastructure</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />

    <!--
      JWT token primitives consumed by Identity/JwtService.cs (stateless JWT Bearer issuance/validation).
        * System.IdentityModel.Tokens.Jwt -> JwtSecurityToken, JwtSecurityTokenHandler, JwtRegisteredClaimNames.
        * Microsoft.IdentityModel.Tokens  -> SymmetricSecurityKey, SigningCredentials, SecurityAlgorithms,
                                             TokenValidationParameters.
      Versions pinned to 7.1.2 per AAP section 0.5.1 and aligned with the transitive Microsoft.IdentityModel.*
      graph that Microsoft.AspNetCore.Authentication.JwtBearer 8.0.11 (Api layer) resolves to, so issuance
      here and validation in the Api pipeline agree on the same token-handling assemblies.
    -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.1.2" />
    <PackageReference Include="Microsoft.IdentityModel.Tokens" Version="7.1.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DnnMigration.Domain\DnnMigration.Domain.csproj" />
    <ProjectReference Include="..\DnnMigration.Application\DnnMigration.Application.csproj" />
  </ItemGroup>

</Project>
