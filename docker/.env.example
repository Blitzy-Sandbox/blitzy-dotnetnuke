# =============================================================================
# docker/.env.example — sample environment for the two-container Compose stack.
# -----------------------------------------------------------------------------
# Docker Compose automatically loads a file named ".env" from the directory it is
# invoked in. Copy this template to ".env" and replace the SAMPLE values below
# with REAL secrets before running `docker-compose build` / `docker-compose up`:
#
#     cp docker/.env.example docker/.env      # then edit docker/.env
#
# docker-compose.yml references these with the REQUIRED form `${VAR:?message}`,
# so `up`/`build` aborts with an explanatory error if either is unset or empty —
# the Production container can never boot with a baked-in default credential.
#
# SECURITY: ".env" holds real secrets and MUST NOT be committed. Ensure it is
# git-ignored. Only this ".env.example" template (with NON-secret placeholders)
# is tracked in source control.
# =============================================================================

# SQL Server connection string to the existing DNN 4.9.0.85 database (schema is
# mapped UNCHANGED — no EF migrations). Replace the host, database, credentials
# and options to match your environment. The value below is a NON-SECRET sample.
ConnectionStrings__Default=Server=your-sql-host,1433;Database=DotNetNuke;User Id=your-db-user;Password=replace-with-a-strong-password;TrustServerCertificate=True;MultipleActiveResultSets=True

# JWT signing key — MUST be at least 32 bytes (256 bits); Program.cs fail-fasts
# on a shorter key. Generate a fresh, high-entropy value per environment, e.g.:
#     openssl rand -base64 48
# The value below is a NON-SECRET sample and MUST be replaced for any real deploy.
Jwt__Key=replace-with-a-real-randomly-generated-signing-key-of-at-least-32-bytes
