# MIGRATION: [Security CWE-798] Template for the runtime secrets that docker/docker-compose.yml requires.
#
# Copy this file to docker/.env and fill in REAL values for your environment:
#     cd docker && cp .env.example .env   # then edit .env
# docker-compose auto-loads a .env file from the directory it runs in (cd docker && docker-compose up -d).
#
# NEVER commit a real docker/.env (it is git-ignored). Only this .env.example — which contains placeholders
# and NO usable credentials — is tracked. These variables have NO fallback defaults in docker-compose.yml
# on purpose; if they are unset the API fail-fasts at startup (Program.cs requires a non-empty, >=32-byte
# Jwt:Key), which is the intended secure default.

# SQL Server connection string for the EXISTING DotNetNuke database (the schema is mapped, not altered).
# Replace the host, the user, and supply a real password. Example shape (do NOT use this literal value):
#   Server=your-sql-host,1433;Database=DotNetNuke;User Id=your-user;Password=REPLACE_WITH_REAL_PASSWORD;TrustServerCertificate=True;Encrypt=False
CONNECTION_STRING=

# JWT signing key. MUST be a high-entropy secret of at least 32 bytes (Program.cs rejects shorter keys).
# Generate a fresh one, e.g.:  openssl rand -base64 48
JWT_SECRET=

# Optional: override the CORS-allowed SPA origin. Defaults to http://localhost:4200 in docker-compose.yml.
# Set this to your real SPA origin in production (this is NOT a secret).
# CORS_ORIGIN=https://your-spa-host
