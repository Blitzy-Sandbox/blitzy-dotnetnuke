# ---------------------------------------------------------------------------
# Setup-agent .gitignore for the migrated DnnMigration stack.
# Scoped to the NEW backend/ (.NET 8) and frontend/ (Angular 19) trees so the
# legacy Library/ and Website/ trees are unaffected. Prevents build artifacts
# and installed dependencies from polluting the working tree / commits.
# ---------------------------------------------------------------------------

# .NET build output (new backend solution)
backend/**/bin/
backend/**/obj/
backend/**/*.user
backend/**/TestResults/

# Node / Angular (new frontend SPA)
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/coverage/
frontend/out-tsc/

# Logs
*.log

# Docker / runtime secrets (CWE-798): never commit real .env files. The .env.example
# template (placeholders only, no real credentials) IS intentionally tracked.
.env
docker/.env
!.env.example
!docker/.env.example

# Agent scratch/evidence output directory (screenshots, recordings, QA logs) - never committed.
blitzy/
